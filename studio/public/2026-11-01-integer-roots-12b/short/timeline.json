  {
   "id": "trick",
   "kind": "scene",
   "chapter": null,
   "from": 319,
   "frames": 376,
   "lines": [
    {
     "text": "Call the roots r and s. Sum and product give this.",
     "caption": "Call the roots r and s. Sum and product give this.",
     "file": "2026-11-01-integer-roots-12b/short/audio/029e224f85585979.wav",
     "from": 0,
     "frames": 100
    },
    {
     "text": "Add one hundred forty-four to both sides. That fills the grid!",
     "caption": "Add 144 to both sides. That fills the grid!",
     "file": "2026-11-01-integer-roots-12b/short/audio/39df29f8e99149d5.wav",
     "from": 104,
     "frames": 100
    },
    {
     "text": "Now the left side factors!",
     "caption": "Now the left side factors!",
     "file": "2026-11-01-integer-roots-12b/short/audio/ac91af7f8f586601.wav",
     "from": 208,
     "frames": 58
    },
    {
     "text": "Its factor pairs: eight positive, and eight negative!",
     "caption": "Its factor pairs: 8 positive, and 8 negative!",
     "file": "2026-11-01-integer-roots-12b/short/audio/a2fab45f6b83b720.wav",
     "from": 271,
     "frames": 94
    }
